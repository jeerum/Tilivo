# Copy to .env and replace all values before deploy. Never commit .env.
POSTGRES_DB=mrjkp_accounting
POSTGRES_USER=mrjkp_accounting_app
POSTGRES_PASSWORD=change-me-to-a-long-random-value
API_HOST_PORT=3100
WEB_HOST_PORT=3101
NODE_ENV=production
LOG_LEVEL=info
EXPOSE_DOCS=false
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
EMAIL_DRIVER=noop
EMAIL_DEV_OUTBOX=false
# 64 hexadecimal characters; generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=replace-with-64-hex-chars
