# EXAMPLE – aktiveeri alles pärast DNS-i lisamist ja sertifikaadi hankimist.
# Salvesta isoleeritud failina /etc/nginx/sites-available/<domain> ja tee
# backup olemasolevast konfigist enne muutmist. Kontrolli: nginx -t

# HTTP -> HTTPS (Let's Encrypt väljakutse)
server {
    listen 80;
    listen [::]:80;
    server_name accounting.EXAMPLE.COM;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name accounting.EXAMPLE.COM;

    ssl_certificate     /etc/letsencrypt/live/accounting.EXAMPLE.COM/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/accounting.EXAMPLE.COM/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 10m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

