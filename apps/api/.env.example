# Local development only. Copy to apps/api/.env and fill in.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://mrjkp_accounting_app:change-me@127.0.0.1:5432/mrjkp_accounting
LOG_LEVEL=debug
EXPOSE_DOCS=true
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
EMAIL_DRIVER=dev
EMAIL_DEV_OUTBOX=true
# 64 hexadecimal characters; generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=replace-with-64-hex-chars
