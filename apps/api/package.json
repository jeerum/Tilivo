{
  "name": "@tilivo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Tilivo API - modular monolith backend",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js up",
    "migrate:down": "node dist/migrate.js down",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "hash-wasm": "^4.12.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "eslint": "^10.9.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.0.4"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
